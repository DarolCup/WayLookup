[Unit]
Description=WayLookup screen translation daemon
PartOf=graphical-session.target
After=graphical-session-pre.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=io.github.waylookup.WayLookup
ExecStart=%h/.local/bin/waylookup daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
